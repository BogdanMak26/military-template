<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="005-create-roles" author="makarenko">
        <createTable tableName="roles">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="005-create-users" author="makarenko">
        <createTable tableName="app_users">  <column name="id" type="BIGINT" autoIncrement="true">
            <constraints primaryKey="true" nullable="false"/>
        </column>
            <column name="username" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="full_name" type="VARCHAR(100)"/>
            <column name="military_rank" type="VARCHAR(50)"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="005-create-user-roles" author="makarenko">
        <createTable tableName="user_roles">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="user_roles" columnNames="user_id, role_id"/>

        <addForeignKeyConstraint baseTableName="user_roles" baseColumnNames="user_id"
                                 referencedTableName="app_users" referencedColumnNames="id"
                                 constraintName="fk_user_roles_user"/>

        <addForeignKeyConstraint baseTableName="user_roles" baseColumnNames="role_id"
                                 referencedTableName="roles" referencedColumnNames="id"
                                 constraintName="fk_user_roles_role"/>
    </changeSet>

    <changeSet id="005-insert-roles-and-admin" author="makarenko">
        <insert tableName="roles">
            <column name="name" value="ROLE_ADMIN"/>
            <column name="description" value="Адміністратор системи"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="ROLE_OPERATOR"/>
            <column name="description" value="Оператор парку"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="ROLE_VIEWER"/>
            <column name="description" value="Спостерігач"/>
        </insert>

        <insert tableName="app_users">
            <column name="username" value="admin"/>
            <column name="email" value="admin@army.gov.ua"/>
            <column name="password" value="$2a$10$N.zmdr9k7uOCQb376ye.5.Z6Q.jF7L8.w/K.m.X/F.X.X.X.X.X"/>
            <column name="full_name" value="System Administrator"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>

        <insert tableName="user_roles">
            <column name="user_id" valueNumeric="1"/>
            <column name="role_id" valueNumeric="1"/>
        </insert>
    </changeSet>

</databaseChangeLog>