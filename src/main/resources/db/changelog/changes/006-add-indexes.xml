<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="006-add-indexes-vehicles" author="makarenko">
        <createIndex indexName="idx_vehicle_status" tableName="vehicles">
            <column name="status"/>
        </createIndex>

        <createIndex indexName="idx_vehicle_driver" tableName="vehicles">
            <column name="driver_id"/>
        </createIndex>

        <createIndex indexName="idx_vehicle_mileage" tableName="vehicles">
            <column name="mileage"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>