<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="seed-categories-v1" author="makarenko">
        <insert tableName="vehicle_categories">
            <column name="name" value="Вантажний автомобіль"/>
            <column name="code" value="TRUCK"/>
            <column name="description" value="Техніка для перевезення вантажів та особового складу"/>
            <column name="required_license" value="C"/>
            <column name="max_load_capacity" valueNumeric="10000"/>
        </insert>

        <insert tableName="vehicle_categories">
            <column name="name" value="Легковий автомобіль"/>
            <column name="code" value="CAR"/>
            <column name="description" value="Командирський та черговий транспорт"/>
            <column name="required_license" value="B"/>
            <column name="max_load_capacity" valueNumeric="500"/>
        </insert>

        <insert tableName="vehicle_categories">
            <column name="name" value="Бронетранспортер"/>
            <column name="code" value="APC"/>
            <column name="description" value="Бойова колісна техніка"/>
            <column name="required_license" value="C"/>
            <column name="max_load_capacity" valueNumeric="5000"/>
        </insert>
    </changeSet>
</databaseChangeLog>